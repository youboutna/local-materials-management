# =============================================================================
# Supabase Project Configuration – HadraTech-GPI (PRODUCTION)
# =============================================================================
# Utilisé pour le déploiement self-hosted (supabase/docker)
# ⚠️ Ne pas utiliser en dev (conflits avec config.toml)
# =============================================================================

# ---- Projet ----
project_id = "hadratech-gpi-prod"

# =============================================================================
# API (aligné avec .env.hadratech section PROD)
# =============================================================================
[api]
port = 8000  # ⚠️ Kong expose le 8000 en self-hosted
schemas = ["public", "btp", "auth", "storage", "graphql_public"]
extra_search_path = ["public", "extensions", "btp"]
max_rows = 1000

# =============================================================================
# Base de données
# =============================================================================
[db]
port = 5432
major_version = 15

[db.pooler]
enabled = true
port = 6543
pool_mode = "transaction"
default_pool_size = 20
max_client_conn = 100

# =============================================================================
# Auth (GoTrue) – PRODUCTION
# =============================================================================
[auth]
enabled = true
site_url = "https://app.hadratech.com"
additional_redirect_urls = [
  "https://app.hadratech.com/auth/callback",
  "https://app.hadratech.com/auth",
  "https://app.hadratech.com/",
  "https://gpi.hadratech.com/auth/callback",
  "https://gpi.hadratech.com/",
  "https://supabase.hadratech.com/auth/v1/callback",
]
jwt_expiry = 3600
enable_signup = true

[auth.email]
enable_signup = true
double_confirm_changes = true
enable_confirmations = false

# =============================================================================
# OAuth Providers – PRODUCTION
# =============================================================================
# ⚠️ Les secrets doivent être injectés via variables d'env
#    (voir .env.local côté front + Dashboard Supabase)

[auth.external.google]
enabled = true
client_id = "env(GOOGLE_CLIENT_ID)"
secret = "env(GOOGLE_CLIENT_SECRET)"
redirect_uri = "https://supabase.hadratech.com/auth/v1/callback"

[auth.external.github]
enabled = true
client_id = "env(GITHUB_CLIENT_ID)"
secret = "env(GITHUB_SECRET)"
redirect_uri = "https://supabase.hadratech.com/auth/v1/callback"

[auth.external.microsoft]
enabled = false
client_id = "env(MICROSOFT_CLIENT_ID)"
secret = "env(MICROSOFT_SECRET)"
redirect_uri = "https://supabase.hadratech.com/auth/v1/callback"

# =============================================================================
# Storage – PRODUCTION
# =============================================================================
[storage]
enabled = true
file_size_limit = "50MiB"

[storage.buckets.documents]
public = false
file_size_limit = "50MiB"
allowed_mime_types = [
  "application/pdf",
  "image/png",
  "image/jpeg",
  "image/webp",
  "application/msword",
  "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
  "application/vnd.ms-excel",
  "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
]

# =============================================================================
# Realtime
# =============================================================================
[realtime]
enabled = true

# =============================================================================
# Edge Functions
# =============================================================================
[functions.send-email-notification]
verify_jwt = false

[functions.send-sms-notification]
verify_jwt = false

[functions.schedule-call]
verify_jwt = false

[functions.assign-task-to-employee]
verify_jwt = false

[functions.send-tender-submission-notification]
verify_jwt = false

[functions.update-email]
verify_jwt = false

[functions.cleanup-expired-user-roles]
verify_jwt = true

# =============================================================================
# Logs
# =============================================================================
[logflare]
enabled = false