# =============================================================================
# SUPABASE SELF-HOSTED – HadraTech-GPI Configuration
# =============================================================================
# ⬇️ MIS À JOUR : aligné avec supabase/config.toml
# =============================================================================

# ---------- Base de données ----------
POSTGRES_PASSWORD=hadratech_db_2025
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=postgres

# ---------- Schémas (alignés avec config.toml) ----------
# config.toml: schemas = ["public", "storage", "graphql_public", "btp"]
PGRST_DB_SCHEMAS=public,btp,auth,storage,graphql_public
PGRST_DB_EXTRA_SEARCH_PATH=public,extensions,btp
PGRST_DB_MAX_ROWS=1000

# ---------- JWT ----------
JWT_SECRET=hadratech_jwt_secret_32_chars_minimum_change_me
JWT_EXPIRY=3600

# ---------- API (aligné avec config.toml) ----------
# config.toml: site_url = "https://539e8f41-564f-4a0a-bf12-5745f07e400b.lovableproject.com"
# Pour self-hosted, on utilise localhost
API_EXTERNAL_URL=http://localhost:8000
SITE_URL=http://localhost:5173
ADDITIONAL_REDIRECT_URLS=http://localhost:5173,http://localhost:5173/auth/callback

# ---------- Supabase Public ----------
SUPABASE_PUBLIC_URL=http://localhost:8000
SUPABASE_PUBLISHABLE_KEY=<generated-publishable-key>
SUPABASE_SECRET_KEY=<generated-secret-key>

# ---------- Anon / Service Keys ----------
ANON_KEY=<generated-anon-key>
SERVICE_ROLE_KEY=<generated-service-role-key>

# ---------- GoTrue (Auth) ----------
DISABLE_SIGNUP=false
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=true  # aligné avec config.toml: auto_confirm_signup = true
ENABLE_ANONYMOUS_USERS=false
ENABLE_PHONE_SIGNUP=false
ENABLE_PHONE_AUTOCONFIRM=false

# ---------- OAuth (aligné avec config.toml) ----------
# config.toml: [auth.external.google]
GOOGLE_ENABLED=true
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/v1/callback

GITHUB_ENABLED=false
GITHUB_CLIENT_ID=
GITHUB_SECRET=

MICROSOFT_ENABLED=false
MICROSOFT_CLIENT_ID=
MICROSOFT_SECRET=

# ---------- SMTP ----------
SMTP_ADMIN_EMAIL=admin@hadratech.com
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=notif@hadratech.com
SMTP_PASS=your_smtp_password
SMTP_SENDER_NAME=HadraTech-GPI Notification

# ---------- URLs GoTrue (aligné avec config.toml) ----------
MAILER_URLPATHS_INVITE=/auth/invite
MAILER_URLPATHS_CONFIRMATION=/auth/confirm
MAILER_URLPATHS_RECOVERY=/auth/recovery
MAILER_URLPATHS_EMAIL_CHANGE=/auth/email-change

# ---------- Kong ----------
KONG_HTTP_PORT=8000
KONG_HTTPS_PORT=8443

# ---------- Storage (aligné avec config.toml) ----------
# config.toml: default_bucket = "documents"
STORAGE_BACKEND=file
GLOBAL_S3_BUCKET=documents
STORAGE_TENANT_ID=hadratech
REGION=us-east-1
S3_PROTOCOL_ACCESS_KEY_ID=minioadmin
S3_PROTOCOL_ACCESS_KEY_SECRET=minioadmin

# ---------- Studio ----------
STUDIO_DEFAULT_ORGANIZATION=HadraTech-GPI
STUDIO_DEFAULT_PROJECT=HadraTech-GPI

# ---------- Realtime ----------
REALTIME_DB_ENC_KEY=supabaserealtime
SECRET_KEY_BASE=supabase_secret_key_base

# ---------- Dashboard ----------
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=hadratech_dashboard_2025

# ---------- Pooler ----------
VAULT_ENC_KEY=supabase_vault_enc_key
POOLER_TENANT_ID=hadratech
POOLER_DEFAULT_POOL_SIZE=20
POOLER_MAX_CLIENT_CONN=100
POOLER_DB_POOL_SIZE=10

# ---------- Meta ----------
PG_META_CRYPTO_KEY=supabase_pg_meta_crypto_key

# ---------- Functions (aligné avec config.toml) ----------
# config.toml: verify_jwt = true par défaut
FUNCTIONS_VERIFY_JWT=true

# ==============================================================
# Variables optionnelles (supprime les warnings)
# ==============================================================

# Pour OpenAPI / Swagger UI
OPENAPI_API_KEY=supabase

# Pour le pooler Supavisor
POOLER_PROXY_PORT_TRANSACTION=6543

# Pour imgproxy (conversion WebP)
IMGPROXY_AUTO_WEBP=false