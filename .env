# =============================================================================
# HADRATECH-GPI – ENVIRONMENT (COMMON)
# =============================================================================
# 📁 Emplacement : .env (racine)
# 🎯 Rôle : Variables communes entre dev et prod
# ⚠️ Ne pas mettre de secrets ici (les VITE_* sont exposés côté client)
# =============================================================================

# ---- Provider switches -------------------------------------------
# auth:    supabase | gotrue | keycloak | local
# data:    supabase | postgrest | local
# storage: supabase | s3 | minio | local
VITE_AUTH_PROVIDER=supabase
VITE_DATA_PROVIDER=supabase
VITE_STORAGE_PROVIDER=supabase

# ---- Schémas configurables ---------------------------------------
# ⚠️ Aligné avec PGRST_DB_SCHEMAS dans supabase/docker/.env.hadratech
VITE_BTP_SCHEMA=btp
VITE_PGRST_SCHEMAS=public,btp
VITE_PGRST_EXTRA_SEARCH_PATH=public

# =============================================================================
# SCÉNARIOS ALTERNATIFS (commentés)
# =============================================================================

# ---- Scenario 1: Supabase Cloud -----------------------------------
# VITE_AUTH_PROVIDER=supabase
# VITE_DATA_PROVIDER=supabase
# VITE_STORAGE_PROVIDER=supabase
# VITE_SUPABASE_URL="https://arenvzltuvjjroigbzlu.supabase.co"
# VITE_SUPABASE_ANON_KEY="<your-anon-key>"

# ---- Scenario 2: Supabase Self-Hosted -----------------------------
# Deploy: cd supabase/docker && sh run.sh start
# Voir supabase/docker/.env.hadratech pour la config backend
# VITE_AUTH_PROVIDER=supabase
# VITE_DATA_PROVIDER=supabase
# VITE_STORAGE_PROVIDER=supabase
# VITE_SUPABASE_URL=http://localhost:8000
# VITE_SUPABASE_ANON_KEY=<generated-anon-key>

# ---- Scenario 3: OSS Légère (GoTrue + PostgREST) ------------------
# VITE_AUTH_PROVIDER=gotrue
# VITE_DATA_PROVIDER=postgrest
# VITE_STORAGE_PROVIDER=s3
# VITE_GOTRUE_URL=http://localhost:9999
# VITE_POSTGREST_URL=http://localhost:3001
# VITE_STORAGE_ENDPOINT=http://localhost:9000
# VITE_STORAGE_ACCESS_KEY=minioadmin
# VITE_STORAGE_SECRET_KEY=minioadmin

# ---- Scenario 4: SSO Entreprise (Keycloak + PostgREST) ------------
# VITE_AUTH_PROVIDER=keycloak
# VITE_DATA_PROVIDER=postgrest
# VITE_STORAGE_PROVIDER=s3
# VITE_KEYCLOAK_URL=http://localhost:8081
# VITE_KEYCLOAK_REALM=etr-ml
# VITE_KEYCLOAK_CLIENT_ID=etr-ml-frontend
# VITE_POSTGREST_URL=http://localhost:3001

# ---- Scenario 5: Développement Local (Mode C offline) ------------
# VITE_AUTH_PROVIDER=local
# VITE_DATA_PROVIDER=local
# VITE_STORAGE_PROVIDER=local
# VITE_DEV_MODE=true

# ---- Scenario 6: Mode B - Local Users + Self-Hosted Data ---------
# VITE_AUTH_PROVIDER=local
# VITE_DATA_PROVIDER=supabase
# VITE_STORAGE_PROVIDER=supabase
# VITE_SUPABASE_URL=http://localhost:8000
# VITE_SUPABASE_ANON_KEY=<generated-anon-key>
# VITE_JWT_SECRET=<doit correspondre à JWT_SECRET de supabase/docker/.env.hadratech>

# =============================================================================
# JOURNALISATION (client + serveur)
# =============================================================================
VITE_LOG_LEVEL="info"
VITE_LOG_SERVER_ENABLED="false"
VITE_LOG_SERVER_URL="/api/logs/export"
VITE_LOG_BATCH_SIZE="50"
VITE_LOG_FLUSH_INTERVAL="300000"
LOG_DIR="/var/logs/app"
LOG_RETENTION_DAYS="30"

# =============================================================================
# MATRICE DE COMPATIBILITÉ (Auto-vérifiée par validateProviders())
# =============================================================================
# Auth \ Data  | supabase | postgrest | local
# --------------------------------------------
# supabase     |    ✅     |    ❌     |   ❌
# gotrue       |    ✅     |    ✅     |   ❌
# keycloak     |    ❌     |    ✅     |   ❌
# local        |  ✅ (B)   |  ✅ (B')  |  ✅ (C)
# =============================================================================