# =============================================================================
# HADRATECH-GPI – ENVIRONMENT DEVELOPMENT
# =============================================================================
# 📁 Emplacement : .env.development (racine)
# 🎯 Rôle : Configuration dev (chargé automatiquement par Vite)
#
# ⚠️ ARCHITECTURE : Ce fichier distingue DEUX serveurs :
#   1. FRONTEND (Vite)     → http://localhost:5173    en local
#                          → https://preview--...devDistant.app  en preview
#   2. BACKEND (Supabase)  → http://localhost:8000    en local
#                          → https://arenvzltuvjjroigbzlu.supabase.co en preview
#
# ⚠️ Le navigateur distant (devDistant) NE PEUT PAS atteindre votre localhost:8000.
#    Pour tester en preview devDistant, on utilise Supabase Cloud.
#    Pour tester en local, on utilise Supabase Self-Hosted Docker.
# =============================================================================

VITE_APP_MODE=production

# ---- Provider switches (DEV) --------------------------------------
VITE_AUTH_PROVIDER=supabase
VITE_DATA_PROVIDER=supabase
VITE_STORAGE_PROVIDER=supabase

# =============================================================================
# 🎯 CONFIGURATION ACTIVE — Preview devDistant (Supabase ClouProviderSettingsd)
# =============================================================================
# ⚠️ Ces valeurs fonctionnent SUR devDistant mais PAS en local.
#    Pour revenir en dev local, commentez ce bloc et décommentez le bloc
#    "CONFIGURATION ACTIVE — Dev local" plus bas.
# =============================================================================

# --- Frontend (URL publique du navigateur) ---
VITE_SITE_URL="https://materials.hadratech.com"
VITE_OAUTH_REDIRECT_URL="https://materials.hadratech.com/auth/callback"

# --- Backend Supabase Cloud ---
VITE_SUPABASE_PROJECT_ID="arenvzltuvjjroigbzlu"
VITE_SUPABASE_PUBLISHABLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImFyZW52emx0dXZqanJvaWdiemx1Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODg5NjAzODAsImV4cCI6MjEwNDUzNjM4MH0.hR9O_feHCqZOibbdaCYwKzjFYi7gwQUp4UPQyfA_Nv0"
VITE_SUPABASE_URL="https://arenvzltuvjjroigbzlu.supabase.co"

VITE_API_URL="https://arenvzltuvjjroigbzlu.supabase.co/rest/v1/"
VITE_AUTH_REDIRECT_URI="https://arenvzltuvjjroigbzlu.supabase.co/auth/v1/callback"
VITE_SUPABASE_UPDATE_EMAIL_FUNCTION_URL="https://arenvzltuvjjroigbzlu.supabase.co/functions/v1/update-email"

# =============================================================================
# 🎯 CONFIGURATION ALTERNATIVE — Dev local (Supabase Self-Hosted Docker)
# =============================================================================
# ⚠️ À utiliser quand vous lancez `docker compose up` sur votre poste.
#    Ces URLs ne fonctionnent PAS depuis devDistant.
# =============================================================================
# VITE_SITE_URL="http://localhost:5173"
# VITE_OAUTH_REDIRECT_URL="http://localhost:5173/auth/callback"
# VITE_SUPABASE_URL="http://localhost:8000"
# VITE_SUPABASE_ANON_KEY="<generated-anon-key-dev>"
# VITE_SUPABASE_PROJECT_ID="hadratech-local"
# VITE_API_URL="http://localhost:8000/rest/v1/"
# VITE_AUTH_REDIRECT_URI="http://localhost:8000/auth/v1/callback"
# VITE_SUPABASE_UPDATE_EMAIL_FUNCTION_URL="http://localhost:8000/functions/v1/update-email"

# ---- JWT partagé (Mode B) ----------------------------------------
# ⚠️ DOIT correspondre à JWT_SECRET dans supabase/docker/.env.hadratech
# (uniquement si VITE_AUTH_PROVIDER=local)
# ⚠️ VITE_JWT_SECRET est dans .env.local
VITE_JWT_EXPIRY=3600

# =============================================================================
# SCÉNARIOS DEV (commentés)
# =============================================================================

# ---- Scenario 1: Supabase Cloud (DEV) -----------------------------
# ✅ Recommandé pour preview devDistant
# VITE_AUTH_PROVIDER=supabase
# VITE_DATA_PROVIDER=supabase
# VITE_STORAGE_PROVIDER=supabase
# VITE_SUPABASE_URL="https://arenvzltuvjjroigbzlu.supabase.co"
# VITE_SUPABASE_ANON_KEY="<anon-key>"

# ---- Scenario 2: Supabase Self-Hosted (DEV) -----------------------
# Deploy: cd supabase/docker && sh run.sh start
# ❌ Ne fonctionne PAS depuis devDistant (localhost inaccessible)
# VITE_AUTH_PROVIDER=supabase
# VITE_DATA_PROVIDER=supabase
# VITE_STORAGE_PROVIDER=supabase
# VITE_SUPABASE_URL=http://localhost:8000
# VITE_SUPABASE_ANON_KEY=<generated-anon-key>

# ---- Scenario 3: OSS Légère (GoTrue + PostgREST) (DEV) ------------
# VITE_AUTH_PROVIDER=gotrue
# VITE_DATA_PROVIDER=postgrest
# VITE_STORAGE_PROVIDER=s3
# VITE_GOTRUE_URL=http://localhost:9999
# VITE_POSTGREST_URL=http://localhost:3001
# VITE_STORAGE_ENDPOINT=http://localhost:9000
# VITE_STORAGE_ACCESS_KEY=minioadmin
# VITE_STORAGE_SECRET_KEY=minioadmin

# ---- Scenario 4: SSO Entreprise (Keycloak + PostgREST) (DEV) ------
# VITE_AUTH_PROVIDER=keycloak
# VITE_DATA_PROVIDER=postgrest
# VITE_STORAGE_PROVIDER=s3
# VITE_KEYCLOAK_URL=http://localhost:8081
# VITE_KEYCLOAK_REALM=etr-ml
# VITE_KEYCLOAK_CLIENT_ID=etr-ml-frontend
# VITE_POSTGREST_URL=http://localhost:3001

# ---- Scenario 5: Développement Local (Mode C offline) (DEV) ------
# VITE_AUTH_PROVIDER=local
# VITE_DATA_PROVIDER=local
# VITE_STORAGE_PROVIDER=local
# VITE_DEV_MODE=true

# ---- Scenario 6: Mode B - Local Users + Self-Hosted Data (DEV) ----
# VITE_AUTH_PROVIDER=local
# VITE_DATA_PROVIDER=supabase
# VITE_STORAGE_PROVIDER=supabase
# VITE_SUPABASE_URL=http://localhost:8000
# VITE_SUPABASE_ANON_KEY=<generated-anon-key>
# VITE_JWT_SECRET=<doit correspondre à JWT_SECRET de supabase/docker/.env.hadratech>

# =============================================================================
# Deno Mail (Edge Functions) – DEV
# =============================================================================
Deno_mail_app_url="https://materials.hadratech.com"
Deno_mail_default_subject="HadraTech-GPI Notification"
Deno_mail_from_name="HadraTech-GPI Notification"
Deno_mail_from_notif="Notif-HadraTech-GPI@hadratech.com"
Deno_mail_smtp_auth_method="LOGIN"
Deno_mail_smtp_port="587"
Deno_mail_smtp_secure="false"
Deno_mail_smtp_server="smtp.office365.com"
Deno_mail_smtp_username="Notif"
Deno_mail_template_path="./email-templates"
VITE_EMAIL_PROVIDER="resend"
RESEND_FROM="onboarding@resend.dev"
# VITE_RESEND_API_KEY, Deno_mail_smtp_password → dans .env.local

# =============================================================================
# STACK ENTREPRISE (docker-compose.keycloak.yml) – DEV
# =============================================================================
KEYCLOAK_ADMIN="admin"
MINIO_ROOT_USER="minioadmin"
PGRST_DB_SCHEMAS="public,btp"
PGRST_DB_EXTRA_SEARCH_PATH="public,extensions"

# =============================================================================
# OAuth Providers (DEV)
# =============================================================================
# ⚠️ CRITIQUE : Ces URLs sont celles où GOOGLE/GITHUB renvoient APRÈS consentement.
#    Elles doivent pointer vers le SERVEUR SUPABASE (GoTrue), PAS vers le frontend.
#    Le frontend ne reçoit JAMAIS le callback directement de Google.
#
#    Flux correct :
#    1. User clique "Google" sur preview--...devDistant.app
#    2. Frontend → https://arenvzltuvjjroigbzlu.supabase.co/auth/v1/authorize
#    3. Supabase → https://accounts.google.com/o/oauth2/auth
#    4. Google → https://arenvzltuvjjroigbzlu.supabase.co/auth/v1/callback  ← CETTE URL
#    5. Supabase → https://preview--...devDistant.app/auth/callback
#
# ⚠️ Ces URLs DOIVENT être déclarées dans Google Cloud Console et GitHub OAuth Apps.
# =============================================================================
GOOGLE_REDIRECT_URI="https://arenvzltuvjjroigbzlu.supabase.co/auth/v1/callback"
GITHUB_REDIRECT_URI="https://arenvzltuvjjroigbzlu.supabase.co/auth/v1/callback"

# ---- Client IDs (publics, exposés côté client) --------------------
VITE_GOOGLE_CLIENT_ID="540384218797-vai1dl2r7uvbe6unb6e1877jj768kfc7.apps.googleusercontent.com"
VITE_GITHUB_CLIENT_ID="Ov23lixZl24SQQynw6Y1"