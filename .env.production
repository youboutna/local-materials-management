# =============================================================================
# HADRATECH-GPI – ENVIRONMENT PRODUCTION
# =============================================================================
# 📁 Emplacement : .env.production (racine)
# 🎯 Rôle : Configuration production (chargé au build)
# 🐳 Cible : Supabase Self-Hosted Docker (supabase.hadratech.com)
# =============================================================================

NODE_ENV=production
VITE_APP_MODE=production

# ---- Provider switches (PROD) -------------------------------------
VITE_AUTH_PROVIDER=supabase
VITE_DATA_PROVIDER=supabase
VITE_STORAGE_PROVIDER=supabase

# ---- URLs publiques (PROD) ----------------------------------------
# ⚠️ ATTENTION : pas de slash final sur VITE_SITE_URL
# ⚠️ Aligné avec supabase/docker/.env.hadratech (section PROD)
VITE_SITE_URL="https://preview--local-materials-management.lovable.app"
VITE_OAUTH_REDIRECT_URL="https://preview--local-materials-management.lovable.app/auth/callback"
VITE_API_URL="https://preview--local-materials-management.lovable.app/rest/v1/"
VITE_AUTH_REDIRECT_URI="https://preview--local-materials-management.lovable.app/auth/v1/callback"

# ---- Supabase Self-Hosted (PROD) ----------------------------------
VITE_SUPABASE_URL="https://supabase.hadratech.com"
VITE_SUPABASE_ANON_KEY="<generated-anon-key-prod>"
VITE_SUPABASE_PROJECT_ID="hadratech-prod"

# ---- Supabase Edge Functions (PROD) -------------------------------
VITE_SUPABASE_UPDATE_EMAIL_FUNCTION_URL="https://preview--local-materials-management.lovable.app/functions/v1/update-email"

# =============================================================================
# SCÉNARIOS PROD ALTERNATIFS (commentés)
# =============================================================================

# ---- Scenario 1: Supabase Cloud (PROD) ----------------------------
# VITE_AUTH_PROVIDER=supabase
# VITE_DATA_PROVIDER=supabase
# VITE_STORAGE_PROVIDER=supabase
# VITE_SUPABASE_URL="https://arenvzltuvjjroigbzlu.supabase.co"
# VITE_SUPABASE_ANON_KEY="<anon-key>"

# ---- Scenario 2: Supabase Self-Hosted (PROD) ----------------------
# Deploy: cd supabase/docker && sh run.sh start
# Voir supabase/docker/.env.hadratech (section PROD) pour la config backend
# VITE_AUTH_PROVIDER=supabase
# VITE_DATA_PROVIDER=supabase
# VITE_STORAGE_PROVIDER=supabase
# VITE_SUPABASE_URL=https://supabase.hadratech.com
# VITE_SUPABASE_ANON_KEY=<generated-anon-key>

# ---- Scenario 3: OSS Légère (GoTrue + PostgREST) (PROD) -----------
# VITE_AUTH_PROVIDER=gotrue
# VITE_DATA_PROVIDER=postgrest
# VITE_STORAGE_PROVIDER=s3
# VITE_GOTRUE_URL=https://auth.hadratech.com
# VITE_POSTGREST_URL=https://api.hadratech.com
# VITE_STORAGE_ENDPOINT=https://storage.hadratech.com
# VITE_STORAGE_ACCESS_KEY=<secret-manager>
# VITE_STORAGE_SECRET_KEY=<secret-manager>

# ---- Scenario 4: SSO Entreprise (Keycloak + PostgREST) (PROD) -----
# VITE_AUTH_PROVIDER=keycloak
# VITE_DATA_PROVIDER=postgrest
# VITE_STORAGE_PROVIDER=s3
# VITE_KEYCLOAK_URL=https://sso.hadratech.com
# VITE_KEYCLOAK_REALM=etr-ml
# VITE_KEYCLOAK_CLIENT_ID=etr-ml-frontend
# VITE_POSTGREST_URL=https://api.hadratech.com

# ---- Scenario 5: Développement Local (Mode C offline) (PROD) ------
# ❌ NON APPLICABLE EN PRODUCTION

# ---- Scenario 6: Mode B - Local Users + Self-Hosted Data (PROD) ---
# ❌ NON RECOMMANDÉ EN PRODUCTION

# =============================================================================
# JOURNALISATION (PROD)
# =============================================================================
VITE_LOG_LEVEL="warning"
VITE_LOG_SERVER_ENABLED="true"
VITE_LOG_SERVER_URL="/api/logs/export"
VITE_LOG_BATCH_SIZE="100"
VITE_LOG_FLUSH_INTERVAL="600000"
LOG_DIR="/var/logs/app"
LOG_RETENTION_DAYS="90"

# =============================================================================
# OAuth Providers (PROD)
# ⚠️ Aligné avec supabase/docker/.env.hadratech (section PROD)
# ⚠️ Les secrets (Client Secret, JWT Secret) → dans .env.local
# =============================================================================
GOOGLE_REDIRECT_URI="https://preview--local-materials-management.lovable.app/auth/v1/callback"
GITHUB_REDIRECT_URI="https://preview--local-materials-management.lovable.app/auth/v1/callback"
VITE_GOOGLE_CLIENT_ID="540384218797-vai1dl2r7uvbe6unb6e1877jj768kfc7.apps.googleusercontent.com"
# 👇 AJOUT POUR COHÉRENCE : VITE_GITHUB_CLIENT_ID manquait
VITE_GITHUB_CLIENT_ID="Ov23lixZl24SQQynw6Y1"

# =============================================================================
# Email (PROD)
# =============================================================================
VITE_EMAIL_PROVIDER="resend"
RESEND_FROM="notifications@hadratech.com"
# VITE_RESEND_API_KEY → dans .env.local

# =============================================================================
# MATRICE DE COMPATIBILITÉ (Auto-vérifiée par validateProviders())
# =============================================================================
# Auth \ Data  | supabase | postgrest | local
# --------------------------------------------
# supabase     |    ✅     |    ❌     |   ❌
# gotrue       |    ✅     |    ✅     |   ❌
# keycloak     |    ❌     |    ✅     |   ❌
# local        |  ✅ (B)   |  ✅ (B')  |  ✅ (C)
# =============================================================================
# Mode B requiert VITE_JWT_SECRET synchronisé avec JWT_SECRET du backend.
# ⚠️ NON RECOMMANDÉ EN PRODUCTION.
# =============================================================================