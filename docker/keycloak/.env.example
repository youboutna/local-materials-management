# =============================================================================
# HADRATECH-GPI – Scénario 4 : Keycloak SSO Entreprise (TEMPLATE)
# =============================================================================
# 📁 Emplacement : docker/keycloak/.env.example
# 🎯 Rôle : Template versionné (sans secrets)
# ⚠️ NE PAS METTRE DE VRAIS SECRETS ICI
# 
# Pour l'utiliser :
#   cp .env.example .env
#   # Puis éditer .env avec les vraies valeurs
# =============================================================================

# ---- Postgres -----------------------------------------------------
POSTGRES_PASSWORD=change_me_postgres_password
POSTGRES_DB=hadratech
POSTGRES_PORT=5432

# ---- PostgREST ----------------------------------------------------
PGRST_DB_SCHEMAS=public,btp
PGRST_DB_EXTRA_SEARCH_PATH=public
POSTGREST_PORT=3001

# ---- JWT (doit correspondre à Keycloak) ---------------------------
# ⚠️ Générer avec : node -e "console.log(require('crypto').randomUUID())"
JWT_SECRET=change_me_jwt_secret_32_chars_minimum
API_EXTERNAL_URL=http://localhost:3001

# ---- Keycloak -----------------------------------------------------
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change_me_keycloak_admin_password
KEYCLOAK_HOSTNAME=localhost
KEYCLOAK_PORT=8080
KEYCLOAK_HTTPS_PORT=8443

# ---- MinIO --------------------------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_minio_password
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001