## 📄 Fichier 6 : `docker/postgrest/.env.example`

> 📁 Emplacement : `docker/postgrest/.env.example`

```env
# =============================================================================
# HADRATECH-GPI – Scénario 3 : OSS Légère (GoTrue + PostgREST + MinIO)
# =============================================================================
# 📁 Emplacement : docker/postgrest/.env.example
# 🎯 Rôle : Template versionné (sans secrets)
# =============================================================================

# ---- Postgres -----------------------------------------------------
POSTGRES_PASSWORD=change_me_postgres_password
POSTGRES_DB=hadratech
POSTGRES_PORT=5433

# ---- PostgREST ----------------------------------------------------
PGRST_DB_SCHEMAS=public,btp
PGRST_DB_EXTRA_SEARCH_PATH=public
POSTGREST_PORT=3001

# ---- GoTrue -------------------------------------------------------
JWT_SECRET=change_me_jwt_secret_32_chars_minimum
JWT_EXPIRY=3600
GOTRUE_PORT=9999
SITE_URL=http://localhost:5173
API_EXTERNAL_URL=http://localhost:9999
DISABLE_SIGNUP=false

# ---- MinIO --------------------------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_minio_password
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001