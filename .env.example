# =============================================================================
# Environment example — single source of truth for provider configuration
# See docs/SELF_HOSTING.md for full deployment scenarios.
# =============================================================================

NODE_ENV=development

# ---- Provider switches (validated at startup by src/config/app-validate.ts) --
# auth:    supabase | gotrue | keycloak | local
# data:    supabase | postgrest | local
# storage: supabase | s3 | minio | local
VITE_AUTH_PROVIDER=supabase
VITE_DATA_PROVIDER=supabase
VITE_STORAGE_PROVIDER=supabase

# ---- Managed Supabase (default) --------------------------------------------
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key
VITE_SUPABASE_PROJECT_ID=your-project-id
VITE_BTP_SCHEMA=btp

# ---- Self-hosted GoTrue (auth=gotrue) --------------------------------------
VITE_GOTRUE_URL=http://localhost:9999

# ---- Self-hosted PostgREST (data=postgrest) --------------------------------
VITE_POSTGREST_URL=http://localhost:3001

# ---- Keycloak (auth=keycloak) ----------------------------------------------
VITE_KEYCLOAK_URL=http://localhost:8081
VITE_KEYCLOAK_REALM=etr-ml
VITE_KEYCLOAK_CLIENT_ID=etr-ml-frontend
VITE_KEYCLOAK_CLIENT_SECRET=

# ---- S3 / MinIO storage (storage=s3|minio) ---------------------------------
VITE_STORAGE_ENDPOINT=http://localhost:9000
VITE_STORAGE_BUCKET=documents
VITE_STORAGE_REGION=us-east-1
VITE_STORAGE_PUBLIC_URL=

# ---- App runtime -----------------------------------------------------------
VITE_API_URL=http://localhost:4000/api
VITE_AUTH_REDIRECT_URI=http://localhost:5173

# ---- Dev mode (auth=local) -------------------------------------------------
# Uses DEV_USERS from src/config/constants.ts; no network calls.
VITE_DEV_MODE=false
