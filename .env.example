# =============================================================================
# HADRATECH-GPI – ENVIRONMENT EXAMPLE
# Single source of truth for provider configuration
# =============================================================================

NODE_ENV=development

# ---- Provider switches -------------------------------------------
# auth:    supabase | gotrue | keycloak | local
# data:    supabase | postgrest | local
# storage: supabase | s3 | minio | local
VITE_AUTH_PROVIDER=supabase
VITE_DATA_PROVIDER=supabase
VITE_STORAGE_PROVIDER=supabase

# ---- Schémas configurables ---------------------------------------
# Correspond à PGRST_DB_SCHEMAS dans docker-compose
VITE_BTP_SCHEMA=btp
VITE_PGRST_SCHEMAS=public,btp
VITE_PGRST_EXTRA_SEARCH_PATH=public

# ---- Scenario 1: Supabase Cloud -----------------------------------
# VITE_AUTH_PROVIDER=supabase
# VITE_DATA_PROVIDER=supabase
# VITE_STORAGE_PROVIDER=supabase
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-key
# VITE_SUPABASE_PROJECT_ID=your-project-id

# ---- Scenario 2: Supabase Self-Hosted -----------------------------
# Deploy: cd supabase/docker && sh run.sh start
# VITE_AUTH_PROVIDER=supabase
# VITE_DATA_PROVIDER=supabase
# VITE_STORAGE_PROVIDER=supabase
# VITE_SUPABASE_URL=http://localhost:8000
# VITE_SUPABASE_ANON_KEY=<generated-anon-key>

# ---- Scenario 3: OSS Légère (GoTrue + PostgREST) ------------------
# Deploy: docker compose -f docker-compose.postgrest.yml up -d
# VITE_AUTH_PROVIDER=gotrue
# VITE_DATA_PROVIDER=postgrest
# VITE_STORAGE_PROVIDER=s3
# VITE_GOTRUE_URL=http://localhost:9999
# VITE_POSTGREST_URL=http://localhost:3001
# VITE_STORAGE_ENDPOINT=http://localhost:9000
# VITE_STORAGE_ACCESS_KEY=minioadmin
# VITE_STORAGE_SECRET_KEY=minioadmin

# ---- Scenario 4: SSO Entreprise (Keycloak + PostgREST) ------------
# Deploy: docker compose up -d
# VITE_AUTH_PROVIDER=keycloak
# VITE_DATA_PROVIDER=postgrest
# VITE_STORAGE_PROVIDER=s3
# VITE_KEYCLOAK_URL=http://localhost:8081
# VITE_KEYCLOAK_REALM=etr-ml
# VITE_KEYCLOAK_CLIENT_ID=etr-ml-frontend
# VITE_POSTGREST_URL=http://localhost:3001

# ---- Scenario 5: Développement Local (Mode C offline) ------------
# VITE_AUTH_PROVIDER=local
# VITE_DATA_PROVIDER=local
# VITE_STORAGE_PROVIDER=local
# VITE_DEV_MODE=true

# ---- Scenario 6: Mode B - Local Users + Self-Hosted Data ---------
# Auth locale (DEV_USERS) + JWT HS256 signé, accepté par la RLS self-hostée.
# VITE_AUTH_PROVIDER=local
# VITE_DATA_PROVIDER=supabase
# VITE_STORAGE_PROVIDER=supabase
# VITE_SUPABASE_URL=http://localhost:8000
# VITE_SUPABASE_ANON_KEY=<generated-anon-key>
# VITE_JWT_SECRET=<doit correspondre à JWT_SECRET de supabase/docker/.env>

# ---- Common runtime ----------------------------------------------
VITE_API_URL=http://localhost:4000/api
VITE_AUTH_REDIRECT_URI=http://localhost:5173

# ---- JWT partagé (Mode B) ----------------------------------------
# LocalAuthAdapter signe des JWT HS256 avec ce secret. Il DOIT correspondre
# à JWT_SECRET de supabase/docker/.env pour que la RLS accepte les tokens.
VITE_JWT_SECRET=please-change-me-32-chars-minimum
VITE_JWT_EXPIRY=3600

# ---- Deno Mail (Edge Functions) ----------------------------------
Deno_mail_app_url="http://localhost:5173"
Deno_mail_default_subject="HadraTech-GPI Notification"
Deno_mail_from_name="HadraTech-GPI Notification"
Deno_mail_from_notif="Notif-HadraTech-GPI@hadratech.com"
Deno_mail_smtp_auth_method="LOGIN"
Deno_mail_smtp_password="YourPasswordHere"
Deno_mail_smtp_port="587"
Deno_mail_smtp_secure="false"
Deno_mail_smtp_server="smtp.office365.com"
Deno_mail_smtp_username="Notif"
Deno_mail_template_path="./email-templates"

# =============================================================================
# MATRICE DE COMPATIBILITÉ (Auto-vérifiée par validateProviders())
# =============================================================================
# Auth \ Data  | supabase | postgrest | local
# --------------------------------------------
# supabase     |    ✅     |    ❌     |   ❌
# gotrue       |    ✅     |    ✅     |   ❌
# keycloak     |    ❌     |    ✅     |   ❌
# local        |  ✅ (B)   |  ✅ (B')  |  ✅ (C)
# =============================================================================
# Mode B requiert VITE_JWT_SECRET synchronisé avec JWT_SECRET du backend.