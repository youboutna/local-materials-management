# Auth Redirect URI
VITE_AUTH_REDIRECT_URI=http://localhost:8080

# ---- Unified multi-provider switch (see docs/SELF_HOSTING.md) ----
# VITE_AUTH_PROVIDER=supabase | gotrue | keycloak | local
# VITE_DATA_PROVIDER=supabase | postgrest | local
# VITE_STORAGE_PROVIDER=supabase | s3 | minio | local

# GoTrue self-hosted
VITE_GOTRUE_URL=http://localhost:9999

# PostgREST self-hosted
VITE_POSTGREST_URL=http://localhost:3001

# S3 / MinIO
