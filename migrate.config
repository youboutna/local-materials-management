#!/bin/bash
# Configuration pour migrate.sh

# Base de données
export DB_NAME="mauritanian_materials"
export DB_USER="app_user"
export DB_HOST="localhost"
export DB_PORT="5432"
export PGPASSWORD="your_password"

# Migrations
export MIGRATION_DIR="./supabase/migrations"
export LOG_TABLE="app_migrations"

# Options
export CHECKSUM_VALIDATION=true

# Exécuter avec options par défaut
./migrate.sh "$@"