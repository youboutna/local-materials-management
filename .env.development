# =============================================================================
# HADRATECH-GPI – ENVIRONMENT DEVELOPMENT
# =============================================================================
# 📁 Emplacement : .env.development (racine)
# 🎯 Rôle : Configuration dev (chargé automatiquement par Vite)
# 🐳 Cible : Supabase Self-Hosted Docker (preview--local-materials-management.lovable.app)
# =============================================================================

NODE_ENV=development
VITE_APP_MODE=development

# ---- Provider switches (DEV) --------------------------------------
VITE_AUTH_PROVIDER=supabase
VITE_DATA_PROVIDER=supabase
VITE_STORAGE_PROVIDER=supabase

# ---- URLs locales (DEV) -------------------------------------------
# ⚠️ Aligné avec supabase/docker/.env.hadratech (section DEV)
VITE_SITE_URL="http://preview--local-materials-management.lovable.app"
VITE_OAUTH_REDIRECT_URL="http://preview--local-materials-management.lovable.app/auth/callback"
VITE_API_URL="http://preview--local-materials-management.lovable.app/rest/v1/"
VITE_AUTH_REDIRECT_URI="http://preview--local-materials-management.lovable.app/auth/v1/callback"

# ---- Supabase Self-Hosted Local (DEV) -----------------------------
# ⚠️ Correspond à ANON_KEY dans supabase/docker/.env.hadratech
VITE_SUPABASE_URL="http://preview--local-materials-management.lovable.app"
VITE_SUPABASE_ANON_KEY="<generated-anon-key-dev>"
VITE_SUPABASE_PROJECT_ID="hadratech-local"

# ---- Supabase Edge Functions (DEV) --------------------------------
VITE_SUPABASE_UPDATE_EMAIL_FUNCTION_URL="http://preview--local-materials-management.lovable.app/functions/v1/update-email"

# ---- JWT partagé (Mode B) ----------------------------------------
# ⚠️ DOIT correspondre à JWT_SECRET dans supabase/docker/.env.hadratech
# (uniquement si VITE_AUTH_PROVIDER=local)
# ⚠️ VITE_JWT_SECRET est dans .env.local
VITE_JWT_EXPIRY=3600

# =============================================================================
# SCÉNARIOS DEV (commentés)
# =============================================================================

# ---- Scenario 1: Supabase Cloud (DEV) -----------------------------
# VITE_AUTH_PROVIDER=supabase
# VITE_DATA_PROVIDER=supabase
# VITE_STORAGE_PROVIDER=supabase
# VITE_SUPABASE_URL="https://arenvzltuvjjroigbzlu.supabase.co"
# VITE_SUPABASE_ANON_KEY="<anon-key>"

# ---- Scenario 2: Supabase Self-Hosted (DEV) -----------------------
# Deploy: cd supabase/docker && sh run.sh start
# VITE_AUTH_PROVIDER=supabase
# VITE_DATA_PROVIDER=supabase
# VITE_STORAGE_PROVIDER=supabase
# VITE_SUPABASE_URL=http://preview--local-materials-management.lovable.app
# VITE_SUPABASE_ANON_KEY=<generated-anon-key>

# ---- Scenario 3: OSS Légère (GoTrue + PostgREST) (DEV) ------------
# VITE_AUTH_PROVIDER=gotrue
# VITE_DATA_PROVIDER=postgrest
# VITE_STORAGE_PROVIDER=s3
# VITE_GOTRUE_URL=http://localhost:9999
# VITE_POSTGREST_URL=http://localhost:3001
# VITE_STORAGE_ENDPOINT=http://localhost:9000
# VITE_STORAGE_ACCESS_KEY=minioadmin
# VITE_STORAGE_SECRET_KEY=minioadmin

# ---- Scenario 4: SSO Entreprise (Keycloak + PostgREST) (DEV) ------
# VITE_AUTH_PROVIDER=keycloak
# VITE_DATA_PROVIDER=postgrest
# VITE_STORAGE_PROVIDER=s3
# VITE_KEYCLOAK_URL=http://localhost:8081
# VITE_KEYCLOAK_REALM=etr-ml
# VITE_KEYCLOAK_CLIENT_ID=etr-ml-frontend
# VITE_POSTGREST_URL=http://localhost:3001

# ---- Scenario 5: Développement Local (Mode C offline) (DEV) ------
# VITE_AUTH_PROVIDER=local
# VITE_DATA_PROVIDER=local
# VITE_STORAGE_PROVIDER=local
# VITE_DEV_MODE=true

# ---- Scenario 6: Mode B - Local Users + Self-Hosted Data (DEV) ----
# VITE_AUTH_PROVIDER=local
# VITE_DATA_PROVIDER=supabase
# VITE_STORAGE_PROVIDER=supabase
# VITE_SUPABASE_URL=http://preview--local-materials-management.lovable.app
# VITE_SUPABASE_ANON_KEY=<generated-anon-key>
# VITE_JWT_SECRET=<doit correspondre à JWT_SECRET de supabase/docker/.env.hadratech>

# =============================================================================
# Deno Mail (Edge Functions) – DEV
# =============================================================================
Deno_mail_app_url="http://preview--local-materials-management.lovable.app"
Deno_mail_default_subject="HadraTech-GPI Notification"
Deno_mail_from_name="HadraTech-GPI Notification"
Deno_mail_from_notif="Notif-HadraTech-GPI@hadratech.com"
Deno_mail_smtp_auth_method="LOGIN"
Deno_mail_smtp_port="587"
Deno_mail_smtp_secure="false"
Deno_mail_smtp_server="smtp.office365.com"
Deno_mail_smtp_username="Notif"
Deno_mail_template_path="./email-templates"
VITE_EMAIL_PROVIDER="resend"
RESEND_FROM="onboarding@resend.dev"
# VITE_RESEND_API_KEY, Deno_mail_smtp_password → dans .env.local

# =============================================================================
# STACK ENTREPRISE (docker-compose.keycloak.yml) – DEV
# =============================================================================
KEYCLOAK_ADMIN="admin"
MINIO_ROOT_USER="minioadmin"
PGRST_DB_SCHEMAS="public,btp"
PGRST_DB_EXTRA_SEARCH_PATH="public,extensions"

# =============================================================================
# OAuth Providers (DEV)
# ⚠️ Aligné avec supabase/docker/.env.hadratech (section DEV)
# ⚠️ Les valeurs réelles (CLIENT_ID, SECRET) → dans .env.local
# =============================================================================
# 👇 CORRECTION APPORTÉE : Utilisation de l'URL publique Lovable pour éviter l'erreur de connexion
GOOGLE_REDIRECT_URI="https://preview--local-materials-management.lovable.app/auth/v1/callback"
GITHUB_REDIRECT_URI="https://preview--local-materials-management.lovable.app/auth/v1/callback"